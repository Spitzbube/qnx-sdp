#!/bin/bash

. $TOOL_DIR/functions

function brief()
{
    echo "--graphics=[yes|no]"
}

function help()
{
    brief
    cat <<EOF
    Include graphics related libraries and binaries.  This will also start screen on boot.

    The default is no.
EOF
}

function validate() {
    if [ "$OPT_GRAPHICS" = yes -o "$OPT_GRAPHICS" = no ]; then
        status=0
        if [ "$OPT_GRAPHICS" = yes ]; then
            if ! check_dependency sbin/screen '--graphics=yes requires the "Screen Base Graphics" package'; then
                status=1
            fi
            if ! check_dependency usr/lib/graphics/vmwgfx-drm/gpu_drm-vmwgfx.so '--graphics=yes requires the "Screen Board Support VMware (vmwgfx)" package'; then
                status=1
            fi
        fi
        exit $status
    else
        echo "--graphics must be set to 'yes' or 'no'"
        exit 1
    fi
}

function configure()
{
    rm -f output/option_files/*.opt_graphics
    if [ "$OPT_GRAPHICS" != no ]; then
        cat >output/option_files/system_files.opt_graphics <<EOF


######################################################
### Common Graphics Files
######################################################
#/usr/share/gles=usr/share/gles
#/usr/share/fonts=usr/share/fonts
#/usr/share/images=usr/share/images
/etc/system/config/img.conf=etc/system/config/img.conf

######################################################
### Graphics - Screen
######################################################
/xbin/screen=sbin/screen
/xbin/drm-vmwgfx=sbin/drm-vmwgfx
/xbin/screencmd=bin/screencmd
/xbin/screeninfo=bin/screeninfo
/xbin/hidview=sbin/hidview

/xbin/gles2-gears=usr/bin/gles2-gears
/xbin/sw-vsync=usr/bin/sw-vsync
#/usr/bin/gles2-maze=usr/bin/gles2-maze
/xbin/font-freetype=usr/bin/font-freetype

########################################
## libraries
########################################
/lib/libgestures.so.1=lib/libgestures.so.1
/lib/libscrmem.so.1=lib/libscrmem.so.1
/lib/libmemobj.so.1=lib/libmemobj.so.1
/lib/libinputevents.so.1=lib/libinputevents.so.1
/lib/libkalman.so.1=lib/libkalman.so.1
/lib/libimg.so.1=lib/libimg.so.1
/lib/libdrm.so.1=usr/lib/libdrm.so.1

########################################
## DLLs
########################################
/lib/dll/screen-debug.so=lib/dll/screen-debug.so
/lib/dll/screen-gles1.so=lib/dll/screen-gles1.so
/lib/dll/screen-gles2.so=lib/dll/screen-gles2.so
/lib/dll/screen-sw.so=lib/dll/screen-sw.so
/lib/dll/screen-stdbuf.so=lib/dll/screen-stdbuf.so
/lib/dll/screen-vmwgfxdrm.so=lib/dll/screen-vmwgfxdrm.so

#########################################
## more libraries
#########################################
/lib/libGLESv2.so.1=usr/lib/libGLESv2.so.1
/lib/libGLESv1_CL.so.1=usr/lib/libGLESv1_CL.so.1
/lib/libGLESv1_CM.so.1=usr/lib/libGLESv1_CM.so.1
/lib/libEGL.so.1=usr/lib/libEGL.so.1
/lib/libscreen.so.1=usr/lib/libscreen.so.1
/lib/libswblit.so.1=usr/lib/libswblit.so.1
[type=link] /lib/libswblit.so=libswblit.so.1
/lib/libWFD.so.1=usr/lib/libWFD.so.1
/lib/libdisputil.so.2=usr/lib/libdisputil.so.2
/lib/libfreetype.so.1=usr/lib/libfreetype.so.1
/lib/libpng16.so.0=usr/lib/libpng16.so.0

#############################################
### Image Loading
#############################################
/lib/dll/img_codec_bmp.so=lib/dll/img_codec_bmp.so
/lib/dll/img_codec_gif.so=lib/dll/img_codec_gif.so
/lib/dll/img_codec_jpg.so=lib/dll/img_codec_jpg.so
/lib/dll/img_codec_png.so=lib/dll/img_codec_png.so
/lib/dll/img_codec_sgi.so=lib/dll/img_codec_sgi.so
/lib/dll/img_codec_tga.so=lib/dll/img_codec_tga.so
