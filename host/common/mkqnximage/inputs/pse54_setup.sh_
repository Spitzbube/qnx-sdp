#!/bin/sh

# -------------------------------------------------------------
# This QNX shell script is used to build the PSE54 VSX test suite
# It must be run as root
# su - root
# sh ./setup.sh
#
# You must have added users: vsx0, vsx1, vsx2
# and their environment setup accordingly.
# Refer to POSIX PSE54 VSX User Guide for more details.
#
# -------------------------------------------------------------

cd /data/home/vsx/vsx4
echo Running from $PWD

CPU=`uname -p`

if [ ! -e /system/xbin/nondev ]; then
   . /system/etc/profile
   export HOME=/data/home/root
   here=`pwd`
   cd /data/home/vsx/qnx/nondev/${OPT_ARCH}/o
   make
   cp nondev /system/xbin
   nondev &
   cd $here
fi

# Default for self-hosted qcc is currently not set.  See CLT-3907.
# The command is benign if the default is already set.
qcc -V5.4.0,gcc_nto$CPU -set-default
if [ $? -ne 0 ]; then
    echo Could not set default for qcc.
    exit 1
fi

# float.h was moved to gcc arch specific directory.  Tetlite framework expects to
# find it in /usr/include.
case $CPU in
"x86")
    cp $QNX_HOST/usr/lib/gcc/i586-pc-nto-qnx7.0.0/5.4.0/include/float.h $QNX_TARGET/usr/include
    ;;
"x86_64")
    cp $QNX_HOST/usr/lib/gcc/x86_64-pc-nto-qnx7.0.0/5.4.0/include/float.h $QNX_TARGET/usr/include
    ;;
esac

# Patch up the headers
if ! grep -q ltoa SRC/INC/tsetlib.h; then
    echo "extern char *ltoa(long);" >>SRC/INC/tsetlib.h
fi


# Build the framework
# VSX documentation states, use make install
# We want this to first CLOBBER to fix compile/link errors
# that complain libapi.a was not built.
# This libapi.a issue randomly occurs when building the PSE54 testsuite.
make -C ../src/tet3 CLOBBER
make -C ../src/tet3 install

find . -name '*.sh' | xargs chmod a+x
HOME=`pwd`
sed -i -e "{
    s!^PATH=.*!PATH=\"/data/home/vsx/vsx4/BIN:/data/home/vsx/src/tet3/tcc:/data/home/vsx/vsx4/bin:/proc/boot:/system/xbin:/data/opt/qnx/7.0/host/usr/bin:/testresources/bin\"!
    s!^INCDIRS.*!INCDIRS=\"$QNX_TARGET/usr/include\"!
    s!^CC.*!CC=\"qcc -g\"!
}" SRC/vsxparams

# Run 'config.sh', accepting all defaults
BIN/config.sh < /dev/null
if [ $? -ne 0 ]; then
    echo config.sh failed
    exit 1
fi

# QNX need to add a file to a directory that is read only for POSIX_ADVISORY_INFO.
mkdir /data/home/vsx/vsx4/qnxtmp
cp /data/home/vsx/vsx4/TestTFile /home/vsx/vsx4/qnxtmp
chmod 555 /data/home/vsx/vsx4/qnxtmp

cp -f SRC/userintf.c.qnx SRC/userintf.c
cp -f SRC/wchars.cfg.qnx SRC/wchars.cfg
cp -f SRC/vsxconfig.h.qnx SRC/vsxconfig.h
cp -r Makefile.qnx Makefile

# filldisc checks for the directory /tmp/vsxmnt and tries to create it if not there.  You can't
# have directories in /tmp so that's not going to work.  But the following makes it appear as
# if the directory exists.  As it then mounts a ram disk at the same spot, this is just fine.
touch /tmp/vsxmnt/x

# -----------------------------------------------------------
# Now that the autogenerated files have been modifed we can complete
# building the testsuite.
#
# Run make without parameters
#   - This will build the following make targets:
#     privchk mktroot dirgid install chmogpriv filldisc vsrt
#
#   - This requires two mountable disks in order execute filldisc
#      SRC/install/scripts/filldisc.sh
#
# NOTE: Currently, /data/home/vsx/vsx4/Makefile does not contain
#       "clean" or "clobber" targets
# -----------------------------------------------------------
make
if [ $? -ne 0 ]; then
    echo make failed
    exit 1
fi
